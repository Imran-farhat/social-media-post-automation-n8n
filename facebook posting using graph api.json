    {
      "parameters": {
        "jsCode": "const url = ($json.media_url || '').toLowerCase();\nconst ext = (url.split('?')[0].split('.').pop() || '').toLowerCase();\n\nconst imageExt = ['jpg','jpeg','png','gif','webp','tiff','bmp','heif'];\nconst videoExt = ['mp4','mov','webm','mkv','avi','flv','m4v','3gp','mp3'];\n\nlet media_type = 'unknown';\nif (imageExt.includes(ext)) media_type = 'image';\nelse if (videoExt.includes(ext)) media_type = 'video';\n\nreturn [{ json: { ...$json, media_type } }];\n"
      },
