        "jsCode": "const url = $input.item.json.media_type || \"\";\n\nconst isVideo =\n  typeof url === \"string\" &&\n  (url.endsWith(\".mp4\") ||\n   url.endsWith(\".mov\") ||\n   url.endsWith(\".webm\") ||\n   url.includes(\"video\"));\n\nreturn [\n  {\n    json: {\n      title: $input.item.json.Title,\n      description: $input.item.json.Description,\n      board_name: $input.item.json[\"Board Name\"],\n      media_url: url,\n      media_type: isVideo ? \"video\" : \"image\"\n    }\n  }\n];\n"
      },
