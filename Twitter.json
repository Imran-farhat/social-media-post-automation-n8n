    {
      "parameters": {
        "jsCode": "const item = $input.item;\n\n// Detect binary key dynamically\nconst binaryKey = Object.keys(item.binary || {})[0];\nif (!binaryKey) throw new Error('No file uploaded');\n\nconst file = item.binary[binaryKey];\n\n// ✅ ALWAYS compute size from actual buffer\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryKey);\nconst size = buffer.length;\n\n// Pass forward\nreturn [{\n  json: {\n    text: item.json[\"Post Content\"],\n    total_bytes: size,        // ✅ use this for INIT\n    media_type: file.mimeType,\n    binaryKey\n  },\n  binary: {\n    [binaryKey]: file\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        -80
      ],
      "id": "b4959b97-822e-47b6-b602-b71ef918cd8c",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const CHUNK_SIZE = 5 * 1024 * 1024; // 5MB\n\n// Get input data properly\nconst item = $input.first();\n\n// Get media_id from INIT\nconst mediaId = item.json.media_id_string;\nif (!mediaId) {\n  throw new Error('media_id_string missing');\n}\n\n// Get binary from merge\nconst binaryKey = Object.keys(item.binary || {})[0];\nif (!binaryKey) {\n  throw new Error('Binary missing after Merge');\n}\n\n// Read binary correctly\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryKey);\nconst totalChunks = Math.ceil(buffer.length / CHUNK_SIZE);\n\nconst items = [];\n\nfor (let i = 0; i < totalChunks; i++) {\n  const start = i * CHUNK_SIZE;\n  const end = Math.min(start + CHUNK_SIZE, buffer.length);\n  const chunkBuffer = buffer.slice(start, end);\n  \n  // ✅ CORRECT: Create proper binary data\n  const chunkBinary = await this.helpers.prepareBinaryData(\n    chunkBuffer,\n    `video_chunk_${i}.mp4`,  // filename\n    'video/mp4'              // mime type\n  );\n  \n  items.push({\n    json: {\n      media_id: mediaId,\n      segment_index: i,\n      total_chunks: totalChunks  // Useful for tracking\n    },\n    binary: {\n      media: chunkBinary  // ✅ Proper n8n binary object\n    }\n  });\n}\n\nconsole.log(`Created ${items.length} chunks for media_id: ${mediaId}`);\nreturn items;"
      },
